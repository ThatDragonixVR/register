<UserControl x:Class="MediaScanner.Views.MediaDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="600" Height="700">
    
    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Media Details" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="1" 
                            Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Poster -->
                    <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource MaterialDesignDivider}" 
                            CornerRadius="8" Width="180" Height="270" Margin="0,0,16,16">
                        <Grid>
                            <Image Source="{Binding MediaItem.PosterUrl}" Stretch="UniformToFill" />
                            <materialDesign:PackIcon Kind="{Binding MediaItem.TypeIcon}" Width="64" Height="64" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding MediaItem.PosterUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Basic Info -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding MediaItem.DisplayTitle}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding MediaItem.Year}" FontSize="16" Opacity="0.8"/>
                            <TextBlock Text=" • " FontSize="16" Opacity="0.8" Margin="4,0"/>
                            <TextBlock Text="{Binding MediaItem.Type}" FontSize="16" Opacity="0.8"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" 
                                    Visibility="{Binding MediaItem.Rating, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}">
                            <materialDesign:RatingBar Value="{Binding MediaItem.Rating}" Max="10" IsReadOnly="True" />
                            <TextBlock Text="{Binding MediaItem.Rating, StringFormat='{0:F1}/10'}" 
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding MediaItem.Genre}" FontSize="14" Opacity="0.8" Margin="0,0,0,8"
                                   Visibility="{Binding MediaItem.Genre, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                    </StackPanel>

                    <!-- Detailed Info -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                        
                        <!-- Description -->
                        <TextBlock Text="Description" FontSize="18" FontWeight="Medium" Margin="0,0,0,8"
                                   Visibility="{Binding MediaItem.Description, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                        <TextBlock Text="{Binding MediaItem.Description}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding MediaItem.Description, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                        <!-- Movie/TV Show Details -->
                        <Grid Visibility="{Binding IsVideoContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Director:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Director, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MediaItem.Director}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Director, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cast:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Cast, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MediaItem.Cast}" TextWrapping="Wrap" Margin="0,4"
                                       Visibility="{Binding MediaItem.Cast, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Runtime, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediaItem.Runtime, StringFormat='{0} minutes'}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Runtime, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Season:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Season, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MediaItem.Season}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Season, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Episode:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Episode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MediaItem.Episode}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Episode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                        </Grid>

                        <!-- Music Details -->
                        <Grid Visibility="{Binding IsMusicContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Artist:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Artist, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MediaItem.Artist}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Artist, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Album:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Album, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MediaItem.Album}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Album, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Track:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Track, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediaItem.Track}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Track, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration:" FontWeight="Medium" Margin="0,4,16,4"
                                       Visibility="{Binding MediaItem.Duration, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DurationFormatted}" Margin="0,4"
                                       Visibility="{Binding MediaItem.Duration, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reverse}"/>
                        </Grid>

                        <!-- File Details -->
                        <TextBlock Text="File Information" FontSize="18" FontWeight="Medium" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Path:" FontWeight="Medium" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MediaItem.FilePath}" TextWrapping="Wrap" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="File Size:" FontWeight="Medium" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSizeFormatted}" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date Modified:" FontWeight="Medium" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediaItem.DateModified, StringFormat='yyyy-MM-dd HH:mm:ss'}" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Actions -->
            <Border Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" Padding="16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh Metadata" 
                            Command="{Binding RefreshMetadataCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Open File Location" 
                            Command="{Binding OpenFileLocationCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Close" 
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>