{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MediaScanner": {
    "DatabasePath": "%APPDATA%\\MediaScanner\\media.db",
    "MaxConcurrentScans": 3,
    "MetadataTimeout": 30000,
    "ScanTimeout": 300000,
    "SupportedVideoExtensions": [
      ".mp4", ".avi", ".mkv", ".mov", ".wmv", ".flv", ".webm", ".m4v", ".mpg", ".mpeg", ".3gp"
    ],
    "SupportedAudioExtensions": [
      ".mp3", ".flac", ".wav", ".aac", ".ogg", ".wma", ".m4a", ".opus", ".aiff"
    ],
    "CommonNasHostnames": [
      "DLINK-SHARECENTER",
      "SYNOLOGY", 
      "QNAP",
      "BUFFALO",
      "NETGEAR",
      "WD-MYCLOUD"
    ]
  },
  "ApiKeys": {
    "OmdbApiKey": "YOUR_OMDB_API_KEY_HERE",
    "Comment": "Get your free OMDB API key from http://www.omdbapi.com/"
  }
}