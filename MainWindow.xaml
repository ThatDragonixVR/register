<Window x:Class="MediaScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Media Scanner" Height="800" Width="1200"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Harddisk" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="Media Scanner" FontSize="24" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                Command="{Binding ScanDrivesCommand}"
                                ToolTip="Scan for Network Drives">
                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                Command="{Binding SettingsCommand}"
                                ToolTip="Settings">
                            <materialDesign:PackIcon Kind="Settings" Width="24" Height="24"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Drives and Filters -->
                <materialDesign:Card Grid.Column="0" Margin="8" materialDesign:ElevationAssist.Elevation="Dp1">
                    <ScrollViewer>
                        <StackPanel>
                            <!-- Drives Section -->
                            <Expander Header="Network Drives" IsExpanded="True" Margin="8">
                                <ItemsControl ItemsSource="{Binding AvailableDrives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Style="{StaticResource MediaCardStyle}" Margin="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <materialDesign:PackIcon Grid.Column="0" Kind="Server" Width="24" Height="24" VerticalAlignment="Center"/>
                                                    
                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Path}" Opacity="0.7" FontSize="12"/>
                                                    </StackPanel>
                                                    
                                                    <Button Grid.Column="2" 
                                                            Style="{StaticResource MaterialDesignIconButton}"
                                                            Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Scan Drive">
                                                        <materialDesign:PackIcon Kind="FolderSearch" Width="16" Height="16"/>
                                                    </Button>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- Filters Section -->
                            <Expander Header="Filters" IsExpanded="True" Margin="8">
                                <StackPanel>
                                    <TextBox materialDesign:HintAssist.Hint="Search media..." 
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="8"/>
                                    
                                    <TextBlock Text="Media Type" Style="{StaticResource SubHeaderTextStyle}" Margin="8,16,8,8"/>
                                    <CheckBox Content="Movies" IsChecked="{Binding ShowMovies}" Margin="8,4"/>
                                    <CheckBox Content="TV Shows" IsChecked="{Binding ShowTVShows}" Margin="8,4"/>
                                    <CheckBox Content="Music" IsChecked="{Binding ShowMusic}" Margin="8,4"/>
                                    <CheckBox Content="Other" IsChecked="{Binding ShowOther}" Margin="8,4"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>

                <!-- Right Panel - Media Library -->
                <materialDesign:Card Grid.Column="1" Margin="8" materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Media Library Header -->
                        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignDivider}" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Media Library" Style="{StaticResource HeaderTextStyle}"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding MediaItems.Count, StringFormat='{0} items'}" 
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ComboBox SelectedValue="{Binding ViewMode}" MinWidth="120">
                                        <ComboBoxItem Content="Grid View"/>
                                        <ComboBoxItem Content="List View"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Media Items -->
                        <ScrollViewer Grid.Row="1" Padding="8">
                            <ItemsControl ItemsSource="{Binding FilteredMediaItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Style="{StaticResource MediaCardStyle}" Width="250" Height="350" Cursor="Hand">
                                            <materialDesign:Card.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </materialDesign:Card.InputBindings>
                                            
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="200"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Poster/Thumbnail -->
                                                <Border Grid.Row="0" Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4">
                                                    <Grid>
                                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                                        <materialDesign:PackIcon Kind="{Binding TypeIcon}" Width="48" Height="48" 
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding PosterUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Media Info -->
                                                <StackPanel Grid.Row="1" Margin="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="40"/>
                                                    <TextBlock Text="{Binding Year}" Opacity="0.7" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Type}" Opacity="0.7" FontSize="12"/>
                                                    
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <materialDesign:RatingBar Value="{Binding Rating}" Max="10" 
                                                                                  IsReadOnly="True" 
                                                                                  Visibility="{Binding Rating, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding Rating, StringFormat='{0:F1}'}" 
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   Visibility="{Binding Rating, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Status Bar -->
            <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryDark" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                    
                    <ProgressBar Grid.Column="1" Width="200" Height="6" 
                                 IsIndeterminate="{Binding IsScanning}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </materialDesign:ColorZone>
        </Grid>
    </materialDesign:DialogHost>
</Window>